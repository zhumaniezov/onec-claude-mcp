
#Область ОбработчикиСобытий

// GET /v1/capabilities. Контракт HTTP-сервиса, доступного текущему пользователю.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - Входящий запрос.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - Возможности расширения или отказ в доступе.
Функция ВозможностиПолучить(Запрос)

	Если Не ДоступРазрешен() Тогда
		Возврат ОтветJSON(403, Новый Структура("error", "forbidden"));
	КонецЕсли;

	ВидыОбъектов = Новый Массив;
	ВидыОбъектов.Добавить("Catalog");
	ВидыОбъектов.Добавить("Document");
	Данные = Новый Структура;
	Данные.Вставить("protocolVersion", 1);
	Данные.Вставить("extensionVersion", "1.2.1");
	Данные.Вставить("dataTransport", "odata-v3");
	Данные.Вставить("metadataKinds", ВидыОбъектов);
	Данные.Вставить("fieldLimits", Истина);
	Данные.Вставить("atomicWrites", РольДоступна("MCP_АтомарнаяЗапись"));
	Данные.Вставить("protectsPostedDocuments", Истина);
	Возврат ОтветJSON(200, Данные);

КонецФункции

// GET /v1/metadata. Возвращает имена и синонимы объектов с правом чтения.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - Входящий запрос.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - Объекты метаданных или отказ в доступе.
Функция ОбъектыПолучить(Запрос)

	Если Не ДоступРазрешен() Тогда
		Возврат ОтветJSON(403, Новый Структура("error", "forbidden"));
	КонецЕсли;

	Объекты = Новый Массив;
	ДобавитьДоступныеОбъекты(Объекты, Метаданные.Справочники, "Catalog");
	ДобавитьДоступныеОбъекты(Объекты, Метаданные.Документы, "Document");
	Возврат ОтветJSON(200, Новый Структура("objects", Объекты));

КонецФункции

// GET /v1/field-limits/{kind}/{name}. Имена полей соответствуют стандартному интерфейсу OData.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - Запрос с видом и внутренним именем объекта в адресе.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - Максимальные длины доступных строковых полей или ошибка доступа и поиска.
Функция ОграниченияПолейПолучить(Запрос)

	Если Не ДоступРазрешен() Тогда
		Возврат ОтветJSON(403, Новый Структура("error", "forbidden"));
	КонецЕсли;

	ВидОбъекта = Запрос.ПараметрыURL.Получить("kind");
	ИмяОбъекта = Запрос.ПараметрыURL.Получить("name");
	Если ВидОбъекта = "Catalog" Тогда
		Объект = Метаданные.Справочники.Найти(ИмяОбъекта);
	ИначеЕсли ВидОбъекта = "Document" Тогда
		Объект = Метаданные.Документы.Найти(ИмяОбъекта);
	Иначе
		Возврат ОтветJSON(404, Новый Структура("error", "not_found"));
	КонецЕсли;

	Если Объект = Неопределено Или Не ПравоДоступа("Чтение", Объект) Тогда
		Возврат ОтветJSON(404, Новый Структура("error", "not_found"));
	КонецЕсли;

	Ограничения = Новый Соответствие;
	Если ВидОбъекта = "Catalog" Тогда
		Если Объект.ДлинаНаименования > 0 Тогда
			ДобавитьДлинуСтандартногоПоля(Ограничения, "Description", Объект, "Наименование", Объект.ДлинаНаименования);
		КонецЕсли;
		Если Объект.ДлинаКода > 0 Тогда
			ДобавитьДлинуСтандартногоПоля(Ограничения, "Code", Объект, "Код", Объект.ДлинаКода);
		КонецЕсли;
	Иначе
		Если Объект.ДлинаНомера > 0 Тогда
			ДобавитьДлинуСтандартногоПоля(Ограничения, "Number", Объект, "Номер", Объект.ДлинаНомера);
		КонецЕсли;
	КонецЕсли;
	Для Каждого Реквизит Из Объект.Реквизиты Цикл
		Если ПравоДоступа("Просмотр", Реквизит) И ОднозначныйСтроковыйТип(Реквизит) Тогда
			ДлинаПоля = Реквизит.Тип.КвалификаторыСтроки.Длина;
			Если ДлинаПоля > 0 Тогда
				Ограничения.Вставить(Реквизит.Имя, ДлинаПоля);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ОтветJSON(200, Новый Структура("limits", Ограничения));

КонецФункции

// POST /v1/change. Меняет существующий объект с проверкой версии под транзакционной блокировкой.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - Параметры изменения в JSON.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - Ссылка и новая версия при успехе или код отказа.
Функция ИзменениеВыполнить(Запрос)

	Если ПривилегированныйРежим() Или Не РольДоступна("MCP_АтомарнаяЗапись") Тогда
		Возврат ОтветJSON(403, Новый Структура("error", "forbidden"));
	КонецЕсли;

	Отказ = Новый Структура("Код, Причина", 500, "internal_error");
	Попытка
		Параметры = ПараметрыЗапроса(Запрос, Отказ);
		Ответ = ВыполнитьИзменение(Параметры, Отказ);
	Исключение
		Если Отказ.Код >= 500 Тогда
			ЗарегистрироватьСбой(Отказ.Причина, ИнформацияОбОшибке());
		КонецЕсли;
		Возврат ОтветJSON(Отказ.Код, Новый Структура("error", Отказ.Причина));
	КонецПопытки;
	Возврат Ответ;

КонецФункции

// POST /v1/write-scope. Заменяет список коллекций, разрешённых для атомарной записи.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - Массив точных имён коллекций в свойстве collections.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - Сохранённая область или отказ.
Функция ОбластьЗаписиВыполнить(Запрос)
	Если ПривилегированныйРежим() Или Не РольДоступна("MCP_НастройкаЗаписи") Тогда
		Возврат ОтветJSON(403, Новый Структура("error", "forbidden"));
	КонецЕсли;
	Отказ = Новый Структура("Код, Причина", 500, "internal_error");
	Попытка
		Параметры = ПараметрыЗапроса(Запрос, Отказ);
		Ответ = УстановитьОбластьЗаписи(Параметры, Отказ);
	Исключение
		Если Отказ.Код >= 500 Тогда
			ЗарегистрироватьСбой("scope_update", ИнформацияОбОшибке());
		КонецЕсли;
		Возврат ОтветJSON(Отказ.Код, Новый Структура("error", Отказ.Причина));
	КонецПопытки;
	Возврат ОтветJSON(200, Ответ);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Причина фиксируется до исключения. Клиенту возвращается только код протокола.
Процедура ОтклонитьИзменение(Отказ, Код, Причина)
	Отказ.Код = Код;
	Отказ.Причина = Причина;
	ВызватьИсключение Причина;
КонецПроцедуры

Процедура ЗарегистрироватьСбой(Этап, Сбой)
	// В журнале только стадия, системный код и местоположение. Ни описание, ни данные объекта не выводятся.
	Сообщение = СтрШаблон("%1 [%2] %3 (%4)", Этап, Сбой.Код, Сбой.ИмяМодуля, Сбой.НомерСтроки);
	ЗаписьЖурналаРегистрации("OneCMCP.Change", УровеньЖурналаРегистрации.Ошибка, , , Сообщение);
КонецПроцедуры

Функция ПараметрыЗапроса(Запрос, Отказ)
	Тело = Запрос.ПолучитьТелоКакДвоичныеДанные();
	Если Тело = Неопределено Тогда
		ОтклонитьИзменение(Отказ, 400, "invalid_json");
	КонецЕсли;
	Если Тело.Размер() > 4 * 1024 * 1024 Тогда
		ОтклонитьИзменение(Отказ, 413, "request_too_large");
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Тело, КодировкаТекста.UTF8));
		Параметры = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		ОтклонитьИзменение(Отказ, 400, "invalid_json");
	КонецПопытки;
	Возврат Параметры;
КонецФункции

Функция УстановитьОбластьЗаписи(Параметры, Отказ)
	Если ТипЗнч(Параметры) <> Тип("Соответствие") Или Параметры.Количество() <> 1 Тогда
		ОтклонитьИзменение(Отказ, 400, "invalid_scope");
	КонецЕсли;
	Коллекции = Параметры.Получить("collections");
	Если ТипЗнч(Коллекции) <> Тип("Массив") Или Коллекции.Количество() > 4096 Тогда
		ОтклонитьИзменение(Отказ, 400, "invalid_scope");
	КонецЕсли;
	// Исполняется под обычными полномочиями администратора, который настраивает доступ.
	Попытка
		Опубликованы = ПолучитьСоставСтандартногоИнтерфейсаOData();
	Исключение
		ОтклонитьИзменение(Отказ, 403, "odata_scope_forbidden");
	КонецПопытки;
	Проверены = Новый Соответствие;
	Для Каждого Коллекция Из Коллекции Цикл
		Если ТипЗнч(Коллекция) <> Тип("Строка") Или СтрДлина(Коллекция) > 255 Или СтрНайти(Коллекция, "*") > 0
			Или Проверены.Получить(Коллекция) <> Неопределено Тогда
			ОтклонитьИзменение(Отказ, 400, "invalid_scope");
		КонецЕсли;
		Если СтрНачинаетсяС(Коллекция, "Catalog_") Тогда
			Мета = Метаданные.Справочники.Найти(Сред(Коллекция, 9));
			Префикс = "Catalog_";
		ИначеЕсли СтрНачинаетсяС(Коллекция, "Document_") Тогда
			Мета = Метаданные.Документы.Найти(Сред(Коллекция, 10));
			Префикс = "Document_";
		Иначе
			ОтклонитьИзменение(Отказ, 422, "unknown_collection");
		КонецЕсли;
		Если Мета = Неопределено Или Коллекция <> Префикс + Мета.Имя Или Опубликованы.Найти(Мета) = Неопределено Тогда
			ОтклонитьИзменение(Отказ, 422, "unknown_collection");
		КонецЕсли;
		Проверены.Вставить(Коллекция, Истина);
	КонецЦикла;

	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	Попытка
		ЗаблокироватьОбластьЗаписи(РежимБлокировкиДанных.Исключительный, Отказ);
		Константы.MCP_ОбластьЗаписи.Установить(СтрСоединить(Коллекции, Символы.ПС));
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Новый Структура("collections", Коллекции);
КонецФункции

Процедура ЗаблокироватьОбластьЗаписи(Режим, Отказ)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Метаданные.Константы.MCP_ОбластьЗаписи.ПолноеИмя());
	Элемент.Режим = Режим;
	Попытка
		Блокировка.Заблокировать();
	Исключение
		ЗарегистрироватьСбой("scope_lock_unavailable", ИнформацияОбОшибке());
		ОтклонитьИзменение(Отказ, 409, "lock_unavailable");
	КонецПопытки;
КонецПроцедуры

Функция ВыполнитьИзменение(Параметры, Отказ)
	Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		ОтклонитьИзменение(Отказ, 400, "invalid_request");
	КонецЕсли;
	ДопустимыеКлючи = СтрРазделить("operation,collection,id,version,data,replaceTableSections", ",");
	Для Каждого Пара Из Параметры Цикл
		Если ДопустимыеКлючи.Найти(Пара.Ключ) = Неопределено Тогда
			ОтклонитьИзменение(Отказ, 400, "invalid_request");
		КонецЕсли;
	КонецЦикла;
	Операция = Параметры.Получить("operation");
	Поля = Параметры.Получить("data");
	ЗаменаЧастей = Параметры.Получить("replaceTableSections");
	Если Операция = "update" Тогда
		Если ТипЗнч(Поля) <> Тип("Соответствие") Или Поля.Количество() = 0 Или Поля.Количество() > 512 Тогда
			ОтклонитьИзменение(Отказ, 400, "invalid_fields");
		КонецЕсли;
		Если ЗаменаЧастей <> Неопределено И ТипЗнч(ЗаменаЧастей) <> Тип("Булево") Тогда
			ОтклонитьИзменение(Отказ, 400, "invalid_request");
		КонецЕсли;
	ИначеЕсли (Операция <> "mark" И Операция <> "delete") Или Поля <> Неопределено Или ЗаменаЧастей <> Неопределено Тогда
		ОтклонитьИзменение(Отказ, 400, "invalid_request");
	КонецЕсли;

	Коллекция = Параметры.Получить("collection");
	Версия = Параметры.Получить("version");
	ИД = Параметры.Получить("id");
	Если ТипЗнч(Коллекция) <> Тип("Строка") Или ТипЗнч(Версия) <> Тип("Строка") Или ПустаяСтрока(Версия)
		Или СтрДлина(Версия) > 256 Или ТипЗнч(ИД) <> Тип("Строка") Или СтрДлина(ИД) <> 36 Тогда
		ОтклонитьИзменение(Отказ, 400, "invalid_request");
	КонецЕсли;
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(ИД);
	Исключение
		ОтклонитьИзменение(Отказ, 400, "invalid_id");
	КонецПопытки;
	Если Идентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000") Тогда
		ОтклонитьИзменение(Отказ, 400, "invalid_id");
	КонецЕсли;

	ЭтоДокумент = СтрНачинаетсяС(Коллекция, "Document_");
	Если СтрНачинаетсяС(Коллекция, "Catalog_") Тогда
		Имя = Сред(Коллекция, 9);
		Мета = Метаданные.Справочники.Найти(Имя);
		Менеджеры = Справочники;
	ИначеЕсли ЭтоДокумент Тогда
		Имя = Сред(Коллекция, 10);
		Мета = Метаданные.Документы.Найти(Имя);
		Менеджеры = Документы;
	Иначе
		ОтклонитьИзменение(Отказ, 404, "not_found");
	КонецЕсли;
	Если Мета = Неопределено Или Не ПравоДоступа("Чтение", Мета) Тогда
		ОтклонитьИзменение(Отказ, 404, "not_found");
	КонецЕсли;
	НужноеПраво = ?(Операция = "delete", "Удаление", "Изменение");
	Если Не ПравоДоступа(НужноеПраво, Мета) Тогда
		ОтклонитьИзменение(Отказ, 403, "forbidden");
	КонецЕсли;
	Ссылка = Менеджеры[Мета.Имя].ПолучитьСсылку(Идентификатор);

	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	Попытка
		ЗаблокироватьОбластьЗаписи(РежимБлокировкиДанных.Разделяемый, Отказ);
		Область = СтрРазделить(Константы.MCP_ОбластьЗаписи.Получить(), Символы.ПС, Ложь);
		Если Область.Найти(Коллекция) = Неопределено Тогда
			ОтклонитьИзменение(Отказ, 403, "collection_not_allowed");
		КонецЕсли;
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(Мета.ПолноеИмя());
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Ссылка", Ссылка);
		Попытка
			Блокировка.Заблокировать();
		Исключение
			ЗарегистрироватьСбой("lock_unavailable", ИнформацияОбОшибке());
			ОтклонитьИзменение(Отказ, 409, "lock_unavailable");
		КонецПопытки;

		Если Не СсылкаДоступна(Мета, Ссылка) Тогда
			ОтклонитьИзменение(Отказ, 404, "not_found");
		КонецЕсли;
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			ОтклонитьИзменение(Отказ, 404, "not_found");
		КонецЕсли;
		Если Объект.ВерсияДанных <> Версия Тогда
			ОтклонитьИзменение(Отказ, 412, "version_mismatch");
		КонецЕсли;
		Если ЭтоДокумент И Объект.Проведен Тогда
			ОтклонитьИзменение(Отказ, 422, "posted_document");
		КонецЕсли;

		НоваяВерсия = Неопределено;
		Если Операция = "delete" Тогда
			ЗафиксироватьОбъект(Объект, Истина, Отказ);
		Иначе
			Если Операция = "mark" Тогда
				ПроверитьСтандартноеПоле(Мета, "ПометкаУдаления", Отказ);
				Объект.ПометкаУдаления = Истина;
			Иначе
				ИзменитьПоляОбъекта(Объект, Мета, Поля, ЗаменаЧастей = Истина, Отказ);
			КонецЕсли;
			ЗафиксироватьОбъект(Объект, Ложь, Отказ);
			НоваяВерсия = Объект.ВерсияДанных;
		КонецЕсли;
		Ответ = ОтветJSON(200, Новый Структура("id, version", Строка(Идентификатор), НоваяВерсия));
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Процедура ЗафиксироватьОбъект(Объект, ЭтоУдаление, Отказ)
	Попытка
		Если ЭтоУдаление Тогда
			Объект.Удалить();
		Иначе
			Объект.Записать();
		КонецЕсли;
	Исключение
		ЗарегистрироватьСбой("write_rejected", ИнформацияОбОшибке());
		ОтклонитьИзменение(Отказ, 422, "write_rejected");
	КонецПопытки;
КонецПроцедуры

Функция СсылкаДоступна(Мета, Ссылка)
	// Имя таблицы поступает исключительно из объекта метаданных платформы.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Т.Ссылка ИЗ " + Мета.ПолноеИмя()
		+ " КАК Т ГДЕ Т.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Процедура ПроверитьСтандартноеПоле(Мета, Имя, Отказ)
	Если Не ПравоДоступа("Просмотр", Мета, , Имя) Или Не ПравоДоступа("Редактирование", Мета, , Имя) Тогда
		ОтклонитьИзменение(Отказ, 403, "field_forbidden");
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПрикладноеПоле(Поле, Отказ)
	Если Не ПравоДоступа("Просмотр", Поле) Или Не ПравоДоступа("Редактирование", Поле) Тогда
		ОтклонитьИзменение(Отказ, 403, "field_forbidden");
	КонецЕсли;
КонецПроцедуры

Процедура ИзменитьПоляОбъекта(Объект, Мета, Поля, ЗаменаЧастей, Отказ)
	СистемныеПоля = СтрРазделить("Ref_Key,DataVersion,DeletionMark,Posted,Predefined,PredefinedDataName", ",");
	Для Каждого Пара Из Поля Цикл
		Имя = Пара.Ключ;
		Если СистемныеПоля.Найти(Имя) <> Неопределено Тогда
			ОтклонитьИзменение(Отказ, 422, "reserved_field");
		КонецЕсли;
		Часть = Мета.ТабличныеЧасти.Найти(Имя);
		Если Часть <> Неопределено Тогда
			Если Не ЗаменаЧастей Или ТипЗнч(Пара.Значение) <> Тип("Массив") Тогда
				ОтклонитьИзменение(Отказ, 422, "table_replacement_not_confirmed");
			КонецЕсли;
			ЗаменитьСтроки(Объект, Часть, Пара.Значение, Отказ);
		Иначе
			ИмяСтандартного = ИмяСтандартногоПоля(Мета, Имя);
			Если ИмяСтандартного <> "" Тогда
				ПроверитьСтандартноеПоле(Мета, ИмяСтандартного, Отказ);
				Поле = Мета.СтандартныеРеквизиты[ИмяСтандартного];
				Значение = ЗначениеПоля(Поле, Пара.Значение, СтрЗаканчиваетсяНа(Имя, "_Key"), Отказ);
				Если ТипЗнч(Значение) = Тип("Строка") Тогда
					Если Имя = "Description" И СтрДлина(Значение) > Мета.ДлинаНаименования
						Или Имя = "Code" И СтрДлина(Значение) > Мета.ДлинаКода
						Или Имя = "Number" И СтрДлина(Значение) > Мета.ДлинаНомера Тогда
						ОтклонитьИзменение(Отказ, 422, "value_out_of_range");
					КонецЕсли;
				КонецЕсли;
				Объект[ИмяСтандартного] = Значение;
			Иначе
				УстановитьПрикладноеПоле(Объект, Мета.Реквизиты, Пара, Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ИмяСтандартногоПоля(Мета, Имя)
	Если Метаданные.Справочники.Найти(Мета.Имя) = Мета Тогда
		Если Имя = "Description" И Мета.ДлинаНаименования > 0 Тогда
			Возврат "Наименование";
		ИначеЕсли Имя = "Code" И Мета.ДлинаКода > 0 Тогда
			Возврат "Код";
		ИначеЕсли Имя = "Parent_Key" И Мета.Иерархический Тогда
			Возврат "Родитель";
		ИначеЕсли Имя = "Owner_Key" И Мета.Владельцы.Количество() > 0 Тогда
			Возврат "Владелец";
		КонецЕсли;
	Иначе
		Если Имя = "Number" И Мета.ДлинаНомера > 0 Тогда
			Возврат "Номер";
		ИначеЕсли Имя = "Date" Тогда
			Возврат "Дата";
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Процедура ЗаменитьСтроки(Объект, МетаЧасти, ДанныеСтрок, Отказ)
	Если ДанныеСтрок.Количество() > 5000 Тогда
		ОтклонитьИзменение(Отказ, 422, "too_many_rows");
	КонецЕсли;
	ПроверитьПрикладноеПоле(МетаЧасти, Отказ);
	// Очистка заменяет также значения отсутствующих в запросе колонок.
	Для Каждого Колонка Из МетаЧасти.Реквизиты Цикл
		ПроверитьПрикладноеПоле(Колонка, Отказ);
	КонецЦикла;
	Таблица = Объект[МетаЧасти.Имя];
	Таблица.Очистить();
	Для Каждого СтрокаДанных Из ДанныеСтрок Цикл
		Если ТипЗнч(СтрокаДанных) <> Тип("Соответствие") Или СтрокаДанных.Количество() = 0
			Или СтрокаДанных.Количество() > 512 Тогда
			ОтклонитьИзменение(Отказ, 422, "invalid_row");
		КонецЕсли;
		СтрокаОбъекта = Таблица.Добавить();
		Для Каждого Пара Из СтрокаДанных Цикл
			Если Пара.Ключ = "LineNumber" Тогда
				Если ТипЗнч(Пара.Значение) <> Тип("Число") Или Пара.Значение <> СтрокаОбъекта.НомерСтроки Тогда
					ОтклонитьИзменение(Отказ, 422, "invalid_line_number");
				КонецЕсли;
			ИначеЕсли Пара.Ключ = "Ref_Key" Тогда
				Если ТипЗнч(Пара.Значение) <> Тип("Строка") Или НРег(Пара.Значение) <> Строка(Объект.Ссылка.УникальныйИдентификатор()) Тогда
					ОтклонитьИзменение(Отказ, 422, "invalid_row_owner");
				КонецЕсли;
			Иначе
				УстановитьПрикладноеПоле(СтрокаОбъекта, МетаЧасти.Реквизиты, Пара, Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура УстановитьПрикладноеПоле(Приемник, Реквизиты, Пара, Отказ)
	Имя = Пара.Ключ;
	Поле = Реквизиты.Найти(Имя);
	ЭтоСсылка = Ложь;
	Если Поле = Неопределено И СтрЗаканчиваетсяНа(Имя, "_Key") Тогда
		Поле = Реквизиты.Найти(Лев(Имя, СтрДлина(Имя) - 4));
		ЭтоСсылка = Истина;
	КонецЕсли;
	Если Поле = Неопределено Тогда
		ОтклонитьИзменение(Отказ, 422, "unsupported_field");
	КонецЕсли;
	ПроверитьПрикладноеПоле(Поле, Отказ);
	Приемник[Поле.Имя] = ЗначениеПоля(Поле, Пара.Значение, ЭтоСсылка, Отказ);
КонецПроцедуры

Функция ЗначениеПоля(Поле, Вход, ЭтоСсылка, Отказ)
	Типы = Поле.Тип.Типы();
	Если Типы.Количество() <> 1 Тогда
		ОтклонитьИзменение(Отказ, 422, "unsupported_type");
	КонецЕсли;
	ТипПоля = Типы[0];
	Если ЭтоСсылка Тогда
		Возврат СсылкаИзJSON(ТипПоля, Вход, Отказ);
	КонецЕсли;
	Если ТипПоля = Тип("Строка") Тогда
		Если ТипЗнч(Вход) <> Тип("Строка") Тогда
			ОтклонитьИзменение(Отказ, 422, "invalid_string");
		КонецЕсли;
		Предел = Поле.Тип.КвалификаторыСтроки.Длина;
		Если Предел > 0 И СтрДлина(Вход) > Предел Тогда
			ОтклонитьИзменение(Отказ, 422, "value_out_of_range");
		КонецЕсли;
		Возврат Вход;
	ИначеЕсли ТипПоля = Тип("Булево") Тогда
		Если ТипЗнч(Вход) <> Тип("Булево") Тогда
			ОтклонитьИзменение(Отказ, 422, "invalid_boolean");
		КонецЕсли;
		Возврат Вход;
	ИначеЕсли ТипПоля = Тип("Число") Тогда
		Если ТипЗнч(Вход) = Тип("Строка") И СтрДлина(Вход) <= 38 Тогда
			Попытка
				Значение = XMLЗначение(ТипПоля, Вход);
			Исключение
				ОтклонитьИзменение(Отказ, 422, "invalid_number");
			КонецПопытки;
		ИначеЕсли ТипЗнч(Вход) = Тип("Число") Тогда
			Значение = Вход;
		Иначе
			ОтклонитьИзменение(Отказ, 422, "invalid_number");
		КонецЕсли;
		Если Поле.Тип.ПривестиЗначение(Значение) <> Значение Тогда
			ОтклонитьИзменение(Отказ, 422, "value_out_of_range");
		КонецЕсли;
		Возврат Значение;
	ИначеЕсли ТипПоля = Тип("Дата") Тогда
		Если ТипЗнч(Вход) <> Тип("Строка") Или СтрДлина(Вход) <> 19 Или Сред(Вход, 11, 1) <> "T" Тогда
			ОтклонитьИзменение(Отказ, 422, "expected_local_datetime");
		КонецЕсли;
		Попытка
			Значение = XMLЗначение(ТипПоля, Вход);
		Исключение
			ОтклонитьИзменение(Отказ, 422, "invalid_date");
		КонецПопытки;
		Если Поле.Тип.ПривестиЗначение(Значение) <> Значение Тогда
			ОтклонитьИзменение(Отказ, 422, "value_out_of_range");
		КонецЕсли;
		Возврат Значение;
	ИначеЕсли ТипПоля = Тип("УникальныйИдентификатор") И ТипЗнч(Вход) = Тип("Строка") Тогда
		Попытка
			Возврат Новый УникальныйИдентификатор(Вход);
		Исключение
			ОтклонитьИзменение(Отказ, 422, "invalid_guid");
		КонецПопытки;
	КонецЕсли;
	ОтклонитьИзменение(Отказ, 422, "unsupported_type");
КонецФункции

Функция СсылкаИзJSON(ТипПоля, Вход, Отказ)
	Мета = Метаданные.НайтиПоТипу(ТипПоля);
	Если Мета = Неопределено Или ТипЗнч(Вход) <> Тип("Строка") Тогда
		ОтклонитьИзменение(Отказ, 422, "unsupported_reference");
	КонецЕсли;
	Если Не ПравоДоступа("Чтение", Мета) Тогда
		ОтклонитьИзменение(Отказ, 403, "reference_forbidden");
	КонецЕсли;
	Если Метаданные.Справочники.Найти(Мета.Имя) = Мета Тогда
		Менеджер = Справочники[Мета.Имя];
	ИначеЕсли Метаданные.Документы.Найти(Мета.Имя) = Мета Тогда
		Менеджер = Документы[Мета.Имя];
	Иначе
		ОтклонитьИзменение(Отказ, 422, "unsupported_reference");
	КонецЕсли;
	Попытка
		Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Вход));
	Исключение
		ОтклонитьИзменение(Отказ, 422, "invalid_guid");
	КонецПопытки;
	Если Не Ссылка.Пустая() И Не СсылкаДоступна(Мета, Ссылка) Тогда
		ОтклонитьИзменение(Отказ, 422, "unknown_reference");
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ДоступРазрешен()
	Возврат Не ПривилегированныйРежим() И РольДоступна("MCP_ДоступКМетаданным");
КонецФункции

Процедура ДобавитьДлинуСтандартногоПоля(Ограничения, ИмяOData, Объект, ИмяРеквизита, ДлинаПоля)
	Если ПравоДоступа("Просмотр", Объект, , ИмяРеквизита) Тогда
		Реквизит = Объект.СтандартныеРеквизиты[ИмяРеквизита];
		Если ОднозначныйСтроковыйТип(Реквизит) Тогда
			Ограничения.Вставить(ИмяOData, ДлинаПоля);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ОднозначныйСтроковыйТип(Реквизит)
	ТипыПоля = Реквизит.Тип.Типы();
	Возврат ТипыПоля.Количество() = 1 И ТипыПоля[0] = Тип("Строка");
КонецФункции

Процедура ДобавитьДоступныеОбъекты(Результат, КоллекцияМетаданных, ВидОбъекта)
	Для Каждого ОписаниеОбъекта Из КоллекцияМетаданных Цикл
		Если ПравоДоступа("Чтение", ОписаниеОбъекта) Тогда
			Результат.Добавить(Новый Структура("kind, name, synonym", ВидОбъекта,
				ОписаниеОбъекта.Имя, Строка(ОписаниеОбъекта.Синоним)));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ОтветJSON(КодСостояния, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

#КонецОбласти
